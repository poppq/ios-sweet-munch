diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 1e65cf3..85184f4 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -89,7 +89,7 @@ sweet_early_string(const char *s)
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 99) {
+	if (early_disabled || stage > 999) {
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
@@ -101,8 +101,11 @@ sweet_early_mark(unsigned int stage, const char *label)
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_string("SWEET EARLY ");
+	if (stage >= 100) {
+		sweet_early_putc((char)('0' + stage / 100));
+	}
 	if (stage >= 10) {
-		sweet_early_putc((char)('0' + stage / 10));
+		sweet_early_putc((char)('0' + (stage / 10) % 10));
 	}
 	sweet_early_putc((char)('0' + stage % 10));
 	sweet_early_string(": ");
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..2804029 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -98,6 +98,13 @@ struct ucd {
 #define DMA_BOUNCE      0x4000
 #define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern void sweet_early_mark(unsigned int, const char *);
+#define SWEET_UFS_MARK(n, l)    sweet_early_mark((n), (l))
+#else
+#define SWEET_UFS_MARK(n, l)    do { } while (0)
+#endif
+
 static struct {
 	vm_offset_t regs;
 	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
@@ -204,6 +211,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	}
 	__builtin_arm_dsb(0xf);
 
+	SWEET_UFS_MARK(110, "ufs_scsi: ringing doorbell");
 	ufs_wr(REG_UTRLDBR, 1);
 	uint64_t deadline;
 	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
@@ -234,6 +242,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 			delay(1);
 		}
 	}
+	SWEET_UFS_MARK(111, "ufs_scsi: completion seen");
 	__builtin_arm_dsb(0xf);
 	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
 
@@ -356,7 +365,9 @@ ufs_find_partition(const char *want)
 static int
 ufs_take_over_host(void)
 {
+	SWEET_UFS_MARK(105, "take_over_host: about to read HCE");
 	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	SWEET_UFS_MARK(106, "take_over_host: HCE/HCS read ok");
 	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
 		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
 		return ENXIO;
@@ -378,12 +389,14 @@ ufs_take_over_host(void)
 	ufs_wr(REG_UTRLBA, (uint32_t)list);
 	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
 	ufs_wr(REG_UTRLRSR, 1);
+	SWEET_UFS_MARK(107, "take_over_host: list installed");
 	/* Never ring a doorbell unless the host uses our list. */
 	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
 	    !(ufs_rd(REG_UTRLRSR) & 1)) {
 		printf("SWEET UFS: host did not take our request list\n");
 		return EIO;
 	}
+	SWEET_UFS_MARK(108, "take_over_host: done");
 	return 0;
 }
 
@@ -592,6 +605,7 @@ sweet_ufs_init(void)
 	char want[64] = "userdata";
 	int error;
 
+	SWEET_UFS_MARK(100, "ufs_init: entry");
 	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
 	    size < 2 * sizeof(uintptr_t)) {
@@ -607,12 +621,15 @@ sweet_ufs_init(void)
 	su.cache = (cache == 1);
 	su.wait = (wait == 1);
 
+	SWEET_UFS_MARK(101, "ufs_init: device tree ok");
 	su.regs = ml_io_map(reg[0], reg[1]);
+	SWEET_UFS_MARK(102, "ufs_init: registers mapped");
 	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
 	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 		printf("SWEET UFS: no contiguous DMA memory\n");
 		return ENOMEM;
 	}
+	SWEET_UFS_MARK(103, "ufs_init: DMA allocated");
 	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
 	if (!pn) {
 		return ENOMEM;
@@ -622,6 +639,7 @@ sweet_ufs_init(void)
 	su.secsize = DEV_BSIZE;
 
 	lck_mtx_lock(&sweet_ufs_lock);
+	SWEET_UFS_MARK(104, "ufs_init: taking over the host");
 	error = ufs_take_over_host();
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
@@ -630,7 +648,9 @@ sweet_ufs_init(void)
 		}
 	}
 	if (!error) {
+		SWEET_UFS_MARK(109, "ufs_init: reading the GPT");
 		error = ufs_find_partition(want);
+		SWEET_UFS_MARK(112, "ufs_init: GPT searched");
 	}
 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
@@ -645,12 +665,14 @@ sweet_ufs_init(void)
 	if (su.cmajor < 0) {
 		return ENXIO;
 	}
+	SWEET_UFS_MARK(113, "ufs_init: block and char devices added");
 	su.bdev = makedev(su.bmajor, 0);
 	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
 	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = (rw != 0);
 	su.ready = true;
+	SWEET_UFS_MARK(114, "ufs_init: ready");
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
